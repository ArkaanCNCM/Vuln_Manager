# VulnManager — Inbound email ingestion — CONFIG TEMPLATE
# Copy this file to .env and fill in real values. Never commit .env.

# ---- Gmail inbox (dev/test) ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-inbox@gmail.com
# 16-char Gmail app password (Google Account > Security > App passwords)
APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ---- Which email to pick up ----
# Subject is matched as a substring (case-insensitive).
# Leave TARGET_SENDER blank to accept any sender.
TARGET_SUBJECT=Tenable vulnerability scan data
TARGET_SENDER=
